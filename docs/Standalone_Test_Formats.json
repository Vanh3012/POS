{
  "baseUrl": "http://localhost:8080",
  "authHeader": {
    "Authorization": "Bearer YOUR_JWT_TOKEN"
  },
  "notes": [
    "Replace YOUR_JWT_TOKEN with a valid login token.",
    "Replace menuItemId, tableId and orderId with IDs that exist in your database.",
    "For export APIs, use Postman Send and Download to save the file.",
    "VNPAY return/ipn samples need a valid vnp_SecureHash generated by VNPAY or by your VNPAY_HASH_SECRET."
  ],
  "history": {
    "list_all": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders?page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "search": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders?search=Nguyen&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_date": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders?date=2026-05-21&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_month": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders?month=5&year=2026&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_range": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders?startDate=2026-05-01&endDate=2026-05-31&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "detail": {
      "method": "GET",
      "url": "http://localhost:8080/history/orders/1",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "update": {
      "method": "PUT",
      "url": "http://localhost:8080/history/orders/1",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN",
        "Content-Type": "application/json"
      },
      "body": {
        "customerName": "Updated Customer",
        "orderType": "TAKE_AWAY",
        "note": "Updated from standalone JSON",
        "paymentMethod": "CREDIT_CARD",
        "received": 0,
        "items": [
          {
            "menuItemId": 1,
            "quantity": 2,
            "note": "No onion"
          }
        ]
      }
    },
    "delete": {
      "method": "DELETE",
      "url": "http://localhost:8080/history/orders/1",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    }
  },
  "report": {
    "list_all": {
      "method": "GET",
      "url": "http://localhost:8080/report/orders?page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "search": {
      "method": "GET",
      "url": "http://localhost:8080/report/orders?search=coffee&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_date": {
      "method": "GET",
      "url": "http://localhost:8080/report/orders?date=2026-05-21&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_month": {
      "method": "GET",
      "url": "http://localhost:8080/report/orders?month=5&year=2026&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "filter_by_range": {
      "method": "GET",
      "url": "http://localhost:8080/report/orders?startDate=2026-05-01&endDate=2026-05-31&page=0&size=10",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      }
    },
    "export_excel_all": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/excel",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    "export_excel_by_month": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/excel?month=5&year=2026",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    "export_excel_by_range": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/excel?startDate=2026-05-01&endDate=2026-05-31",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
    },
    "export_pdf_all": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/pdf",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/pdf"
    },
    "export_pdf_by_month": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/pdf?month=5&year=2026",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/pdf"
    },
    "export_pdf_by_range": {
      "method": "GET",
      "url": "http://localhost:8080/report/export/pdf?startDate=2026-05-01&endDate=2026-05-31",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedContentType": "application/pdf"
    }
  },
  "vnpay_qr": {
    "create_order_with_vnpay_qr": {
      "method": "POST",
      "url": "http://localhost:8080/cashier/orders",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN",
        "Content-Type": "application/json"
      },
      "body": {
        "customerName": "VNPAY Test Customer",
        "orderType": "TAKE_AWAY",
        "note": "Test VNPAY QR payment",
        "paymentMethod": "QRIS",
        "items": [
          {
            "menuItemId": 1,
            "quantity": 1,
            "note": ""
          }
        ]
      },
      "expectedFields": [
        "data.id",
        "data.paymentStatus = PENDING",
        "data.paymentUrl",
        "data.qrContent",
        "data.transactionRef"
      ]
    },
    "create_qr_for_existing_order": {
      "method": "POST",
      "url": "http://localhost:8080/cashier/orders/1/payments/vnpay-qr",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedFields": [
        "data.orderId",
        "data.paymentId",
        "data.status = PENDING",
        "data.paymentUrl",
        "data.qrContent"
      ]
    },
    "get_print_qr_data": {
      "method": "GET",
      "url": "http://localhost:8080/cashier/orders/1/print",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedFields": [
        "data.orderCode",
        "data.paymentStatus",
        "data.qrContent",
        "data.items",
        "data.totalPrice"
      ]
    },
    "poll_payment_status": {
      "method": "GET",
      "url": "http://localhost:8080/cashier/orders/1/payment-status",
      "headers": {
        "Authorization": "Bearer YOUR_JWT_TOKEN"
      },
      "expectedFields": [
        "data.paymentStatus",
        "data.transactionRef",
        "data.providerTransactionNo",
        "data.paidAt"
      ]
    },
    "vnpay_return_sample": {
      "method": "GET",
      "url": "http://localhost:8080/payments/vnpay/return?vnp_TxnRef=ORDER1-123456789&vnp_Amount=1000000&vnp_ResponseCode=00&vnp_TransactionStatus=00&vnp_TransactionNo=14000000&vnp_BankCode=NCB&vnp_SecureHash=REPLACE_WITH_VALID_HASH",
      "headers": {},
      "note": "This only works with a valid vnp_SecureHash and amount matching the payment."
    },
    "vnpay_ipn_sample": {
      "method": "GET",
      "url": "http://localhost:8080/payments/vnpay/ipn?vnp_TxnRef=ORDER1-123456789&vnp_Amount=1000000&vnp_ResponseCode=00&vnp_TransactionStatus=00&vnp_TransactionNo=14000000&vnp_BankCode=NCB&vnp_SecureHash=REPLACE_WITH_VALID_HASH",
      "headers": {},
      "expectedResponse": {
        "RspCode": "00",
        "Message": "Confirm Success"
      },
      "note": "This only works with a valid vnp_SecureHash and amount matching the payment."
    }
  }
}
